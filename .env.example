# Base URL of the future FastAPI backend. Leave unset to keep using in-memory mocks.
VITE_API_BASE_URL=http://localhost:8000/api

# Google OAuth 2.0 Client ID — get this from Google Cloud Console:
# https://console.cloud.google.com/ -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# Add http://localhost:5173 as an Authorized JavaScript Origin.
VITE_GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
